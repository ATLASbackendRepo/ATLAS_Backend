{
  "ConnectionStrings": {
    "//": "LOW-01: no credential belongs in version control. Supply this through user-secrets, an environment variable (ConnectionStrings__DefaultConnection) or the .env file used by docker-compose - see .env.example.",
    "DefaultConnection": ""
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },

  "Jwt": {
    "Key": "",
    "Issuer": "StudentApi",
    "Audience": "StudentApiUsers",
    "ExpiryMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Seq": {
    "ServerUrl": "http://seq:80"
  },

  "Kestrel": {
    "AddServerHeader": false
  },

  "ForwardedHeaders": {
    "KnownProxies": []
  },

  "Discord": {
    "WebhookUrl": "",
    "Enabled": false
  },

  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "",
    "SenderPassword": "",
    "RecipientEmail": "",
    "EnableSsl": true
  },

  "AllowedHosts": "*"
}
