MSSQL_SA_PASSWORD=replace-with-a-strong-secret
SEQ_ADMIN_PASSWORD=replace-with-a-strong-secret

# The application refuses to start unless this is at least 64 characters long.
# Generate one with: openssl rand -base64 64
Jwt__Key=replace-with-a-random-secret-of-at-least-64-characters-generated-for-this-environment
Discord__WebhookUrl=

# Bootstrap administrator. Leave the academic ID or the password empty to skip
# seeding. On an empty database the seed creates the institution and the
# department below as well, so no manual SQL is needed for the first login.
Seed__FirstAdmin__AcademicId=sa01
Seed__FirstAdmin__Password=replace-with-a-strong-secret
Seed__FirstAdmin__FullName=ATLAS Administrator
Seed__Institution__Name=ATLAS University
Seed__Department__Name=General

